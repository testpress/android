<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pa_stat_card_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/pa_stat_card_border" />
            <corners android:radius="@dimen/pa_spinner_radius" />

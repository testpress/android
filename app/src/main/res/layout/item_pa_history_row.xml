<?xml version="1.0" encoding="utf-8"?>
<TableRow xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp">

    <!-- 1. Date -->
    <TextView
        android:id="@+id/tv_date"
        android:layout_width="@dimen/pa_col_date_width"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 2. Exam -->
    <TextView
        android:id="@+id/tv_exam"
        android:layout_width="@dimen/pa_col_exam_width"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:textAlignment="viewStart"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 3. Roll No -->
    <TextView
        android:id="@+id/tv_roll_no"
        android:layout_width="@dimen/pa_col_roll_no_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 4. PHY -->
    <TextView
        android:id="@+id/tv_phy"
        android:layout_width="@dimen/pa_col_subject_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 5. CHE -->
    <TextView
        android:id="@+id/tv_che"
        android:layout_width="@dimen/pa_col_subject_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 6. BIO -->
    <TextView
        android:id="@+id/tv_bio"
        android:layout_width="@dimen/pa_col_subject_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 7. Mat -->
    <TextView
        android:id="@+id/tv_mat"
        android:layout_width="@dimen/pa_col_subject_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 8. APT -->
    <TextView
        android:id="@+id/tv_apt"
        android:layout_width="@dimen/pa_col_subject_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 9. DRW -->
    <TextView
        android:id="@+id/tv_drw"
        android:layout_width="@dimen/pa_col_subject_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 10. P-I -->
    <TextView
        android:id="@+id/tv_p1"
        android:layout_width="@dimen/pa_col_subject_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 11. P-II -->
    <TextView
        android:id="@+id/tv_p2"
        android:layout_width="@dimen/pa_col_subject_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 12. Total -->
    <TextView
        android:id="@+id/tv_total"
        android:layout_width="@dimen/pa_col_total_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_strong"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- 13. Max -->
    <TextView
        android:id="@+id/tv_max"
        android:layout_width="@dimen/pa_col_max_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 14. Highest -->
    <TextView
        android:id="@+id/tv_highest"
        android:layout_width="@dimen/pa_col_highest_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 15. % -->
    <TextView
        android:id="@+id/tv_percent"
        android:layout_width="@dimen/pa_col_percent_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 16. Grade -->
    <FrameLayout
        android:id="@+id/layout_grade"
        android:layout_width="@dimen/pa_col_grade_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v">

        <TextView
            android:id="@+id/tv_grade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/pa_badge_success_bg"
            android:gravity="center"
            android:paddingStart="@dimen/pa_badge_padding_h"
            android:paddingTop="@dimen/pa_badge_padding_v"
            android:paddingEnd="@dimen/pa_badge_padding_h"
            android:paddingBottom="@dimen/pa_badge_padding_v"
            android:textColor="@color/pa_badge_success_text"
            android:textSize="11sp" />

    </FrameLayout>

    <!-- 17. Rank -->
    <TextView
        android:id="@+id/tv_rank"
        android:layout_width="@dimen/pa_col_rank_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 18. Out Of -->
    <TextView
        android:id="@+id/tv_out_of"
        android:layout_width="@dimen/pa_col_out_of_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 19. Status -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="@dimen/pa_col_status_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 20. Scholarship Earned -->
    <TextView
        android:id="@+id/tv_scholar_earn"
        android:layout_width="@dimen/pa_col_scholarship_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 21. Remarks -->
    <TextView
        android:id="@+id/tv_remarks"
        android:layout_width="@dimen/pa_col_remarks_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp"
        android:visibility="gone" />


    <!-- 22. Appeared -->
    <TextView
        android:id="@+id/tv_appeared"
        android:layout_width="@dimen/pa_col_appeared_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 23. OMR -->
    <TextView
        android:id="@+id/tv_omr"
        android:layout_width="@dimen/pa_col_omr_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

    <!-- 24. Result -->
    <TextView
        android:id="@+id/tv_result"
        android:layout_width="@dimen/pa_col_result_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pa_table_cell_padding_h"
        android:paddingTop="@dimen/pa_table_cell_padding_v"
        android:paddingEnd="@dimen/pa_table_cell_padding_h"
        android:paddingBottom="@dimen/pa_table_cell_padding_v"
        android:textColor="@color/pa_table_cell_text"
        android:textSize="12sp" />

</TableRow>
